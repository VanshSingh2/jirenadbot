# ===== Jiren Ads Bot - environment configuration =====
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Values here override the (insecure) defaults baked into config.py.
# IMPORTANT: the tokens currently in config.py are committed to git and must be
# rotated in BotFather / MongoDB Atlas before going to production.

# --- Telegram ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_TOKEN=
OWNER_ID=
LOGGER_BOT_TOKEN=
LOGGER_BOT_USERNAME=
NOTIFICATION_BOT_TOKEN=
NOTIFICATION_CHANNEL_ID=

# Fernet key used to encrypt stored Telegram sessions. Generate ONCE and keep it
# constant forever (changing it makes existing saved sessions undecryptable):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Database (use a paid/dedicated cluster for scale, e.g. Atlas M10+) ---
# For Atlas:      mongodb+srv://user:pass@cluster0.xxx.mongodb.net/gokuads_db?retryWrites=true&w=majority
# For self-hosted Mongo via docker-compose (recommended for cost): point at the
# `mongo` service using the credentials below:
#   MONGO_URI=mongodb://USER:PASS@mongo:27017/gokuads_db?authSource=admin
MONGO_URI=
MONGO_DB_NAME=gokuads_db
# Self-hosted Mongo (docker-compose `mongo` service) credentials + RAM cap:
MONGO_ROOT_USER=jiren
MONGO_ROOT_PASS=change-me-strong
MONGO_CACHE_GB=1.5
# Connection pool / timeout tuning
MONGO_MAX_POOL=50
MONGO_MIN_POOL=5
MONGO_SERVER_SELECTION_MS=8000
MONGO_CONNECT_MS=8000
MONGO_SOCKET_MS=20000

# --- Caches (seconds) ---
USER_CACHE_TTL=5
ADMIN_CACHE_TTL=30
LOGS_CACHE_TTL=20
# Thread pool for offloaded blocking DB ops (UI handlers + worker reads run in
# parallel instead of serializing on the event loop). Raise for very busy UIs.
DB_THREAD_POOL=64

# --- Forwarding behavior ---
PEERFLOOD_COOLDOWN=3600
RESUME_STAGGER_SECONDS=2
RECONCILE_INTERVAL=15
START_BATCH=25

# ===== Scaling: roles, workers, proxies =====
# BOT_ROLE: "all" (default, single process runs UI + forwarding),
#           "bot" (only the Telegram UI bots; does NOT forward),
#           "worker" (only forwards its shard; does NOT serve the UI bot).
BOT_ROLE=all
# Number of FORWARDING workers and this process's worker index (0-based).
# Single process => WORKER_COUNT=1, WORKER_ID=0 (owns every account).
WORKER_COUNT=1
WORKER_ID=0

# Proxies (optional now; add when you scale past ~1 IP's safe limit).
# Format: one proxy per line OR separated by ';'
#   type:host:port            (no auth)
#   type:host:port:user:pass  (with auth)
# type is one of: socks5 | socks4 | http
# Proxies are assigned STICKILY per account (an account always uses the same one).
# Example:
# PROXY_LIST=socks5:1.2.3.4:1080:user:pass;socks5:5.6.7.8:1080
PROXY_LIST=


# ===== Auto-scaling manager (run `python manager.py` instead of bot.py) =====
# The manager keeps 1 UI bot + N forwarding workers alive and scales N to load.
MAX_ACCOUNTS_PER_WORKER=100   # baseline soft cap per worker (auto-lowered for small boxes)
AUTO_WORKER_CAP=1             # 1 = auto-detect CPU/RAM and LOWER the cap if the box is small (never raises above the baseline)
PER_ACCOUNT_MB=15             # estimated RAM per connected account (for auto-cap math)
RAM_RESERVE_MB=1024           # RAM left for OS + UI bot + overhead (for auto-cap math)
WORKER_CAP_MIN=20             # auto-cap won't go below this
WORKER_CAP_MAX=200            # auto-cap won't go above this
PER_IP_CAP=40                 # safe logged-in accounts per proxy/IP (Telegram limit)
MIN_WORKERS=1
MAX_WORKERS=16
MANAGER_INTERVAL=60           # seconds between scaling checks
DOWN_STABLE_CYCLES=5          # require N calm cycles before scaling down (anti-flap)
PROXY_ALERT_INTERVAL=3600     # min seconds between "add more proxies" admin DMs
PROXY_WARN_FILL=0.85          # warn when active accounts exceed this fraction of proxy capacity

# ===== Health-adaptive per-worker cap (manager reacts to runtime errors) =====
# Workers report sends/fails/floods/timeouts; the manager shrinks accounts/worker
# (=> more workers) on connection stress and recovers when calm. Flood is alerted
# (needs proxies/slower freq), not "fixed" with more workers.
HEALTH_REPORT_INTERVAL=30     # how often each worker writes a health snapshot (bot.py)
STRESS_TIMEOUT_RATE=0.05      # timeouts/op above which a worker is "stressed"
FLOOD_ALERT_RATE=0.10         # (floods+peerfloods)/sends above which admin is alerted
MIN_OPS_FOR_SIGNAL=50         # ignore windows with fewer ops than this
CAP_STEP_DOWN=0.8             # shrink cap to 80% under stress
CAP_STEP_UP=1.15              # grow cap 15% when healthy
STRESS_CYCLES=2               # stressed cycles before shrinking
RECOVER_CYCLES=10             # calm cycles before growing
CAP_CHANGE_COOLDOWN=600       # min seconds between cap changes (anti-thrash)
HEALTH_STALE_SECONDS=120      # ignore worker health older than this

# ===== Throughput / logging efficiency =====
LIVE_SEND_LOGS=0              # per-send live logs to logger bot (OFF by default; round summaries always sent). Set 1 only at small scale.
LIVE_LOG_MAX_PENDING=200      # drop live logs beyond this many in-flight (back-pressure)
BROADCAST_DELAY=0.1           # seconds between admin-broadcast sends
HEALTH_INTERVAL=300           # seconds between [HEALTH] log lines


# ===== Anti-ban (Tier 1) =====
# Spintax is automatic (use {a|b|c} in the custom ad text; no setting needed).
# Smart rotation uses the per-user "Smart Rotation" toggle in the bot.
ROTATION_CHUNK=25            # groups sent per round when smart rotation is ON
WARMUP_ENABLED=1             # new accounts ramp up gradually before full speed
WARMUP_DAYS=2                # warmup window in days (HARD-CAPPED at 2)
WARMUP_MIN_FRACTION=0.15     # day-0 starts at this fraction of groups
WARMUP_MIN_GROUPS=5          # but never fewer than this many groups
HEALTH_PEERFLOOD_LIMIT=3     # auto-pause an account after N consecutive PeerFlood rounds

# (via the "🎯 Times/Hour per Group" button or /freq <n>), the bot computes the
# cycle delay so each group is messaged ~N times/hour regardless of group count.
TARGET_MIN_CYCLE_FLOOR=30     # minimum pause (s) between rounds in target mode
MIN_MSG_DELAY=5               # hard floor for per-message delay (anti-burst safety)
TG_TIMEOUT=30                 # Telethon connect/request timeout in seconds (default 10)


# Global per-group send frequency policy (admin-managed; users CANNOT change it).
DEFAULT_TARGET_PER_HOUR=3     # default times/hour per group
HARD_MAX_TARGET_PER_HOUR=3    # hard cap; admin /freq cannot exceed this


# ===== Growth tools =====
JOIN_DELAY=4                 # base seconds between group joins (anti-flood; jittered)
FIND_GROUPS_LIMIT=50         # max groups returned by the niche finder per search
# Niche finder crawler (finds many more groups by reading seed groups' messages):
FIND_CRAWL_SEEDS=3           # seed groups to crawl (0 = name-search only)
FIND_CRAWL_MSGS=60           # recent messages scanned per seed
FIND_CRAWL_RESOLVE=40        # max candidate links resolved per search (flood-safety)
# Click tracking (optional): base URL of the n8n redirect webhook
# (import n8n/click-tracker.workflow.json and run it side-by-side). The bot turns
# advertiser links into <N8N_TRACK_BASE>?c=CODE and reads click counts for Results.
N8N_TRACK_BASE=
