# ===== Jiren Ads Bot - environment configuration =====
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Values here override the (insecure) defaults baked into config.py.
# IMPORTANT: the tokens currently in config.py are committed to git and must be
# rotated in BotFather / MongoDB Atlas before going to production.

# --- Telegram ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_TOKEN=
OWNER_ID=
LOGGER_BOT_TOKEN=
LOGGER_BOT_USERNAME=
NOTIFICATION_BOT_TOKEN=
NOTIFICATION_CHANNEL_ID=

# --- Database (use a paid/dedicated cluster for scale, e.g. Atlas M10+) ---
MONGO_URI=
MONGO_DB_NAME=gokuads_db
# Connection pool / timeout tuning
MONGO_MAX_POOL=100
MONGO_MIN_POOL=5
MONGO_SERVER_SELECTION_MS=8000
MONGO_CONNECT_MS=8000
MONGO_SOCKET_MS=20000

# --- Caches (seconds) ---
USER_CACHE_TTL=5
ADMIN_CACHE_TTL=30
LOGS_CACHE_TTL=20

# --- Forwarding behavior ---
PEERFLOOD_COOLDOWN=3600
RESUME_STAGGER_SECONDS=2
RECONCILE_INTERVAL=15
START_BATCH=25

# ===== Scaling: roles, workers, proxies =====
# BOT_ROLE: "all" (default, single process runs UI + forwarding),
#           "bot" (only the Telegram UI bots; does NOT forward),
#           "worker" (only forwards its shard; does NOT serve the UI bot).
BOT_ROLE=all
# Number of FORWARDING workers and this process's worker index (0-based).
# Single process => WORKER_COUNT=1, WORKER_ID=0 (owns every account).
WORKER_COUNT=1
WORKER_ID=0

# Proxies (optional now; add when you scale past ~1 IP's safe limit).
# Format: one proxy per line OR separated by ';'
#   type:host:port            (no auth)
#   type:host:port:user:pass  (with auth)
# type is one of: socks5 | socks4 | http
# Proxies are assigned STICKILY per account (an account always uses the same one).
# Example:
# PROXY_LIST=socks5:1.2.3.4:1080:user:pass;socks5:5.6.7.8:1080
PROXY_LIST=
